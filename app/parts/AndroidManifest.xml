<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.galaxian"
    android:sharedUserId="android.uid.system"
    android:versionCode="7"
    android:versionName="2.3.1">

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.KILL_ALL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:name=".PartsApplication"
        android:label="@string/parts_title"
        android:icon="@drawable/ic_galaxian_parts"
        android:theme="@style/GalaxianParts.Theme">
        <activity
            android:name=".PartsActivity"
            android:exported="true"
            android:permission="android.permission.DEVICE_POWER"
            android:label="@string/parts_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data android:name="com.android.settings.group_key"
                android:value="system_management_category" />
            <meta-data android:name="com.android.settings.order" android:value="110" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/parts_title" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/parts_summary" />
            <meta-data android:name="com.android.settings.icon" android:resource="@drawable/ic_galaxian_parts" />
            <meta-data android:name="com.android.settings.icon_tintable" android:value="true" />
            <meta-data android:name="com.android.settings.keyhint" android:value="galaxian_parts_settings" />
            <meta-data android:name="com.android.settings.profile" android:value="primary_profile_only" />
        </activity>
        <activity
            android:name=".PartsSubActivity"
            android:exported="false"
            android:label="@string/parts_title" />
        <service
            android:name=".adaptive.AdaptiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Opt-in device performance telemetry and adaptive CPU/GPU frequency limits and frame telemetry" />
        </service>
    </application>
</manifest>
