# The request and restore point last only for the current boot.
on post-fs-data
    mkdir /data/vendor/galaxianparts 0700 root root
    restorecon_recursive /data/vendor/galaxianparts
    rm /data/vendor/galaxianparts/thermal_previous
    rm /data/vendor/galaxianparts/thermal_previous.tmp
    setprop sys.galaxianparts.thermal_disabled 0
    setprop vendor.galaxianparts.thermal_state changing
    setprop vendor.galaxianparts.thermal_error none
    setprop vendor.galaxianparts.thermal_errno 0
    setprop vendor.galaxianparts.thermal_profile ""
    setprop vendor.galaxianparts.thermal_result_id 0

# The legacy daemon status has an exact, exported system property label. Without
# it, init rejects this entire vendor action as an unexported property trigger.
# Every request (even a retry of the same value) and daemon restart gets a result.
on property:sys.galaxianparts.thermal_disabled=* && property:sys.boot_completed=1 && property:init.svc.thermal_core=*
    setprop vendor.galaxianparts.thermal_state changing
    restart vendor.galaxian-parts-thermal

service vendor.galaxian-parts-thermal /vendor/bin/galaxian_parts_thermal_control
    class late_start
    # thermal_core creates .current_tp as root:root 0600. No Linux capabilities.
    user root
    group root
    capabilities
    disabled
    oneshot
