From 0a7ffe7f24a7d9b1fbdfb987f9939172d5549439 Mon Sep 17 00:00:00 2001
From: Sujan Bimali <sujanbimali999@gmail.com>
Date: Mon, 12 Oct 2026 01:59:32 +0545
Subject: [PATCH 2/2] Galaga: NTCamera: always wait for preview surface before
 creating session

---
 .../context/module/ModuleContext.smali        | 37 ++++---------------
 1 file changed, 7 insertions(+), 30 deletions(-)

diff --git a/smali_classes5/com/nothing/cameracore/context/module/ModuleContext.smali b/smali_classes5/com/nothing/cameracore/context/module/ModuleContext.smali
index f838f766..1055058b 100644
--- a/smali_classes5/com/nothing/cameracore/context/module/ModuleContext.smali
+++ b/smali_classes5/com/nothing/cameracore/context/module/ModuleContext.smali
@@ -2434,38 +2434,15 @@
 .end method
 
 .method private needWaitSurfaceToCreateSession()Z
-    .locals 3
-
-    .line 943
-    iget-object p0, p0, Lcom/nothing/cameracore/context/module/ModuleContext;->mSubMode:Lcom/nothing/cameracore/context/module/submode/SubModeInterface;
-
-    if-eqz p0, :cond_1
-
-    .line 945
-    invoke-interface {p0}, Lcom/nothing/cameracore/context/module/submode/SubModeInterface;->getSessionType()I
-
-    move-result v0
-
-    const/4 v1, -0x2
-
-    const/4 v2, 0x1
-
-    if-eq v0, v1, :cond_0
-
-    .line 946
-    invoke-interface {p0}, Lcom/nothing/cameracore/context/module/submode/SubModeInterface;->getSessionType()I
-
-    move-result p0
-
-    if-ne p0, v2, :cond_1
-
-    :cond_0
-    return v2
+    .locals 1
 
-    :cond_1
-    const/4 p0, 0x0
+    # PATCH: always wait for the preview SurfaceTexture before creating the
+    # session. Avoids the deferred-OutputConfiguration path whose
+    # finalizeOutputConfigurations() throws "Deferred config is not part of
+    # this session" on Android 17.
+    const/4 v0, 0x1
 
-    return p0
+    return v0
 .end method
 
 .method private onCameraCaptureSessionConfigured(Landroid/hardware/camera2/CameraCaptureSession;)V
-- 
