allow hal_fingerprint_default vendor_goodix_gf_data_file:dir create_dir_perms;
allow hal_fingerprint_default vendor_goodix_gf_data_file:file create_file_perms;

allow hal_fingerprint_default sysfs_panel_feature:file { read write open };

allow hal_fingerprint_default sysfs_fts_fod_mode:file { read write open };

allow hal_fingerprint_default proc_touchpanel:dir { getattr search };
allow hal_fingerprint_default proc_touchpanel:file { read write getattr open };

set_prop(hal_fingerprint_default, virtual_fingerprint_hal_prop)
set_prop(hal_fingerprint_default, vendor_fingerprint_prop)
set_prop(hal_fingerprint_default, vendor_nothing_property)
