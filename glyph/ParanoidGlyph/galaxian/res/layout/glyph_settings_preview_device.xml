<?xml version="1.0" encoding="utf-8"?>
<!--
     Preview of the back of the Nothing Phone (3a) Lite. The device carries a
     single Glyph light near the camera, so there is exactly one preview zone.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_device_background"
    android:clipChildren="false"
    android:layout_width="107.2dp"
    android:layout_height="225.0dp"
    android:layout_gravity="center_horizontal">
        <ImageView
            android:layout_gravity="left"
            android:id="@+id/preview_device_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5.89dp"
            android:layout_marginLeft="5.51dp"
            android:alpha="0.3"
            android:src="@drawable/glyph_led_dot" />
</FrameLayout>
