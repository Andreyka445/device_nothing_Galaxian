<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Paths -->
    <!--
         Galaxian (Nothing Phone (3a) Lite) has a single Glyph light driven by
         the out-of-tree noth_leds driver. The LED class device is registered
         under /sys/class/leds/noth_leds and exposes a single writable "state"
         attribute: 0 is off, 1 is solid and any value above 1 is a breathing
         period in milliseconds. There is no per-zone frame interface and no
         hardware brightness control, so every path collapses onto that node.
    -->
    <string name="glyph_settings_paths_all_absolute" translatable="false">/sys/class/leds/noth_leds/state</string>
    <string name="glyph_settings_paths_frame_absolute" translatable="false">/sys/class/leds/noth_leds/state</string>
    <string name="glyph_settings_paths_mode_absolute" translatable="false"></string>
    <string name="glyph_settings_paths_single_absolute" translatable="false">/sys/class/leds/noth_leds/state</string>
    <string name="glyph_settings_paths_color_absolute" translatable="false"></string>

    <string name="glyph_settings_paths_powershare_active_absolute" translatable="false"></string>
    <string name="glyph_settings_paths_powershare_enabled_absolute" translatable="false"></string>

</resources>
