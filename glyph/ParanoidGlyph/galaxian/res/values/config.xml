<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Device -->
    <string name="glyph_settings_device" translatable="false">galaxian</string>

    <!-- Brightness -->
    <!--
         The noth_leds light is a plain on/off regulator with no brightness
         control, so every value the app writes ends up as either 0 or 1
         (see FileUtils.galaxianLedState). The scale below is therefore only
         used internally, and all of these levels light the Glyph light
         identically. The array still carries several entries because the
         settings UI indexes it directly and defaults to its third slot on
         devices without a colour node (see SettingsManager.getGlyphBrightnessSetting).
    -->
    <integer name="glyph_settings_brightness_max" translatable="false">100</integer>
    <integer-array name="glyph_settings_brightness_levels" translatable="false">
        <item>25</item>
        <item>50</item>
        <item>75</item>
        <item>@integer/glyph_settings_brightness_max</item>
    </integer-array>

</resources>
