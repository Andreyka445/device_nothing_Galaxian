# Audio
ro.audio.silent=0
ro.audio.flinger_standbytime_ms=1000
ro.audio.usb.period_us=16000

# Camera
ro.camera.sound.forced=0

# Display
sys.brightness.disable_gamma_conversion=true

# Radio
persist.radio.nt.modem.svn=15
persist.vendor.mtk.vilte.enable=1
persist.vendor.mtk_rcs_single_reg_support=1
persist.vendor.mtk_rtt_support=1
persist.vendor.pco5.radio.ctrl=0

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true

# NTF
ro.build.nothing.feature.base=0xe24800001004458438124a040106b4247b97ffL
ro.build.nothing.feature.diff.product.GalagaEEA=0x8000000000000000000000L
ro.build.nothing.feature.diff.product.GalagaJPN=0x120000000000000000000000L
ro.build.nothing.feature.diff.product.GalagaIND=0x10000000000000000000000L

# Wifi
wifi.tethering.interface=ap0
